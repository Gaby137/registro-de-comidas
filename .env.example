# =====================================================================
# Copiar a .env y completar:   cp .env.example .env
# .env está en .gitignore: NUNCA subirlo al repo.
# Lo leen docker compose y la app en el perfil dev (mismas credenciales en los dos lados).
# Formato KEY=valor, sin comillas y sin "\" en los valores (Spring lo lee como .properties).
# =====================================================================

# === Proyecto ===
APP_NOMBRE=Comidas
# Puerto de la app (en dev y el que expone docker compose)
APP_PORT=8080
# Zona horaria de la app y de MySQL
TZ=America/Argentina/Buenos_Aires
# Prefijo de contenedores y volúmenes de docker compose (default: nombre de la carpeta)
# COMPOSE_PROJECT_NAME=cliente-xyz

# === Base de datos ===
DB_NAME=comidas_db
DB_USER=appuser
DB_PASS=cambiar-password-db
DB_ROOT_PASS=cambiar-password-root
# Puerto local de MySQL. Si ya tenés otro proyecto del kit corriendo, usá otro (3308, 3309...)
DB_PORT=3307

# === Admin inicial ===
# Se crea al arrancar si no existe ningún ADMIN. Después podés borrar estas líneas.
ADMIN_EMAIL=admin@cliente.com
ADMIN_PASSWORD=

# === Cookies ===
# true en producción (HTTPS). Poné false SOLO para probar el stack prod en localhost sin HTTPS.
COOKIE_SECURE=true
